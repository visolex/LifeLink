rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function hasRole(userId, role) {
      return signedIn() && userProfile(userId).data.role == role;
    }

    function isAdmin() {
      return signedIn() && hasRole(request.auth.uid, "admin");
    }

    function isOrganizer() {
      return signedIn() && hasRole(request.auth.uid, "organizer");
    }

    function isDonor() {
      return signedIn() && hasRole(request.auth.uid, "donor");
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ["donor", "organizer"];

      allow read: if isOwner(userId) || isAdmin()
        || (isOrganizer() && resource.data.role == "donor");

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName",
            "email",
            "phone",
            "location",
            "bloodGroup",
            "availability",
            "organizationName",
            "contactPerson",
            "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    match /bloodRequests/{requestId} {
      allow read: if signedIn();

      allow create: if isOrganizer()
        && request.resource.data.organizerId == request.auth.uid;

      allow update: if isAdmin()
        || (
          isOrganizer()
          && resource.data.organizerId == request.auth.uid
          && request.resource.data.organizerId == resource.data.organizerId
        );

      allow delete: if isAdmin()
        || (
          isOrganizer()
          && resource.data.organizerId == request.auth.uid
        );

      match /responses/{donorId} {
        allow read: if isAdmin()
          || (isDonor() && isOwner(donorId))
          || (isOrganizer() && userProfile(request.auth.uid).data.uid == request.auth.uid
            && get(/databases/$(database)/documents/bloodRequests/$(requestId)).data.organizerId == request.auth.uid);

        allow create, update: if isDonor()
          && isOwner(donorId)
          && request.resource.data.donorId == donorId;

        allow delete: if isAdmin() || (isDonor() && isOwner(donorId));
      }
    }

    match /donations/{donationId} {
      allow read: if isAdmin() || (isDonor() && resource.data.donorId == request.auth.uid);

      allow create: if isAdmin()
        || (
          isOrganizer()
          && get(/databases/$(database)/documents/bloodRequests/$(request.resource.data.requestId)).data.organizerId == request.auth.uid
          && request.resource.data.recordedBy == request.auth.uid
        );

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
